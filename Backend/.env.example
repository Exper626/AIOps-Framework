# Every setting is read once when the server starts (config.py).
# The four keys below are required: the backend won't start without them.

# Vercel AI Gateway: models
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# DashScope: embeddings (knowledge base and memories) and reranking
DASHSCOPE_API_KEY=your_dashscope_key

# Weaviate Cloud, where the knowledge base and each user's memories are stored
WEAVIATE_URL=your_weaviate_cluster_url
WEAVIATE_API_KEY=your_weaviate_api_key

# Optional

# Self-hosted servers (any OpenAI-compatible server: vLLM on Modal, Ollama, LM Studio...), as a JSON list.
# The backend asks each one which models it serves, and they appear under Settings → Self-hosted.
# "kinds" is ["text"], ["vision"] or both, for every model on that server.
# Example: [{"base_url": "https://your-workspace--your-app-serve.modal.run/v1", "kinds": ["text"]}]
SELF_HOSTED_SERVERS=[]
# Only if those servers need a key. For Modal proxy auth: TOKEN_ID.TOKEN_SECRET (wk-....ws-...)
SELF_HOSTED_API_KEY=
# A Modal API token (Modal → Settings → API Tokens: ak-... and as-...). With it, every endpoint running in that
# Modal workspace is found by itself and its models show up in Settings (for Vision too); no SELF_HOSTED_SERVERS
# entry needed.
# The endpoints still need SELF_HOSTED_API_KEY above (the proxy token) to be called.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Which Modal environment to look in; empty is the workspace's default
MODAL_ENVIRONMENT=

# true = send a "Pipeline trace" with every answer (prompts included), for debugging only
DEBUG_TRACE=false
# Seconds the vision model gets to read an attached image
VISION_TIMEOUT_SECONDS=40
# Frontend origins allowed to call the backend, comma-separated
ALLOWED_ORIGINS=*
# Memories (Mem0): a second Weaviate cluster, as a free cluster holds only one collection and the knowledge
# base uses it. Left empty, the knowledge base's cluster above is used.
MEMORY_WEAVIATE_URL=
MEMORY_WEAVIATE_API_KEY=
# The collection the memories are kept in (created on first use)
MEMORY_COLLECTION=Memories
