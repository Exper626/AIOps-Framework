# Every setting is read once when the server starts (config.py).
# The four keys below are required: the backend won't start without them.

# Vercel AI Gateway: models, embeddings
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key

# DashScope for reranking
DASHSCOPE_API_KEY=your_dashscope_key

# Weaviate Cloud, where the knowledge base is stored
WEAVIATE_URL=your_weaviate_cluster_url
WEAVIATE_API_KEY=your_weaviate_api_key

# Optional

# Self-hosted servers (any OpenAI-compatible server: vLLM on Modal, Ollama, LM Studio...), as a JSON list.
# The backend asks each one which models it serves, and they appear under Settings → Self-hosted.
# "kinds" is ["text"], ["vision"] or both, for every model on that server.
# Example: [{"base_url": "https://your-workspace--your-app-serve.modal.run/v1", "kinds": ["text"]}]
SELF_HOSTED_SERVERS=[]
# Only if those servers need a key. For Modal proxy auth: TOKEN_ID.TOKEN_SECRET (wk-....ws-...)
SELF_HOSTED_API_KEY=

# true = send a "Pipeline trace" with every answer (prompts included), for debugging only
DEBUG_TRACE=false
# Seconds the vision model gets to read an attached image
VISION_TIMEOUT_SECONDS=40
# Frontend origins allowed to call the backend, comma-separated
ALLOWED_ORIGINS=*
