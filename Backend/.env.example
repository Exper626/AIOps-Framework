# Vercel AI Gateway for final answer generation
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Chat pipeline: the query and context management agents run before the answer.
# Their models are picked in Settings; these are only used when a request doesn't say.
QUERY_MODEL=xai/grok-4.1-fast-non-reasoning
CONTEXT_MODEL=xai/grok-4.1-fast-non-reasoning
AGENT_TIMEOUT_SECONDS=8
# true = send a "Pipeline trace" with every answer (prompts included), for debugging only
DEBUG_TRACE=false

# Self-hosted models (any OpenAI-compatible server: Ollama, vLLM, LM Studio...), as a JSON list.
# They appear under Settings → Models → Self-hosted. "kinds" is ["text"], ["vision"] or both.
# Example: [{"id": "llama3.1:8b", "name": "Llama 3.1 8B", "base_url": "http://10.0.0.5:11434/v1", "kinds": ["text"]}]
SELF_HOSTED_MODELS=[]
# Only if those servers need an API key
SELF_HOSTED_API_KEY=

# DashScope for embeddings and reranking
DASHSCOPE_API_KEY=your_dashscope_key
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/reranks

# AWS OpenSearch Serverless
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
OPENSEARCH_HOST=your_opensearch_serverless_endpoint
OPENSEARCH_INDEX=nawaloka

# RAG settings
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
RETRIEVAL_TOP_K=20
RERANK_MODEL=qwen3-rerank
RERANK_TOP_N=5
